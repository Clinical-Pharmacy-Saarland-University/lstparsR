$PROBLEM    SYNTHETIC lstparsR test case s06: SAEM, covariance step successful
$INPUT      ID TIME AMT RATE DV MDV
$DATA      synthetic_s06.csv IGNORE=@
$SUBROUTINE ADVAN3 TRANS4
$PK
  CL = THETA(1) * EXP(ETA(1))
  V1 = THETA(2) * EXP(ETA(2))
  Q  = THETA(3)
  V2 = THETA(4)
  S1 = V1
$ERROR
  IPRED = F
  Y     = IPRED + IPRED * EPS(1) + EPS(2)
$THETA  (0, 8) (0, 20) (0, 3) (0, 40)
$OMEGA  0.1 0.1
$SIGMA  0.02 0.05
$ESTIMATION METHOD=SAEM INTERACTION NBURN=2000 NITER=500
$COVARIANCE PRINT=E
$TABLE      ID TIME IPRED CWRES NOPRINT ONEHEADER FILE=synthetic_s06.tab
  
