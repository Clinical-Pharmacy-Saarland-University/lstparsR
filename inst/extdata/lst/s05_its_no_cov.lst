$PROBLEM    SYNTHETIC lstparsR test case s05: ITS, no covariance step
$INPUT      ID TIME AMT DV MDV EVID WT
$DATA      synthetic_s05.csv IGNORE=@
$SUBROUTINE ADVAN2 TRANS2
$PK
  TVCL = THETA(1) * (WT / 70)**THETA(4)
  CL   = TVCL * EXP(ETA(1))
  V    = THETA(2) * EXP(ETA(2))
  KA   = THETA(3) * EXP(ETA(3))
  S2   = V
$ERROR
  IPRED = F
  Y     = IPRED * (1 + EPS(1))
$THETA  (0, 4) (0, 30) (0, 1) 0.75
$OMEGA  0.1 0.1 0.3
$SIGMA  0.03
$ESTIMATION METHOD=ITS INTERACTION NITER=50
$TABLE      ID TIME IPRED CWRES NOPRINT ONEHEADER FILE=synthetic_s05.tab
  
