$PROBLEM    SYNTHETIC lstparsR test case s25: 11 residual-error variances
$INPUT      ID TIME AMT DV MDV EVID ASSAY
$DATA      synthetic_s25.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  CL = THETA(1) * EXP(ETA(1))
  V  = THETA(2) * EXP(ETA(2))
  S1 = V
$ERROR
  ; one proportional error per invented assay 1-11
  Y = F * (1 + EPS(ASSAY))
$THETA  (0, 3) (0, 18)
$OMEGA  0.1 0.1
$SIGMA  11*0.03
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999 PRINT=5
$COVARIANCE PRINT=E
  
NM-TRAN MESSAGES 
  
