$PROBLEM    SYNTHETIC lstparsR test case s16: S matrix singular
$INPUT      ID TIME AMT RATE DV MDV
$DATA      synthetic_s16.csv IGNORE=@
$SUBROUTINE ADVAN3 TRANS4
$PK
  CL = THETA(1) * EXP(ETA(1))
  V1 = THETA(2) * EXP(ETA(2))
  Q  = THETA(3)
  V2 = THETA(4)
  S1 = V1
$ERROR
  IPRED = F
  Y     = IPRED + IPRED * EPS(1) + EPS(2)
$THETA  (0, 8) (0, 20) (0, 3) (0, 40)
$OMEGA  0.1 0.1
$SIGMA  0.02 0.05
$ESTIMATION METHOD=1 MAXEVAL=9999 PRINT=5
$COVARIANCE PRINT=E
$TABLE      ID TIME IPRED CWRES NOPRINT ONEHEADER FILE=synthetic_s16.tab
  
