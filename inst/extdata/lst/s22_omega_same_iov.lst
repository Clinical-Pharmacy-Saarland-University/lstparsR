$PROBLEM    SYNTHETIC lstparsR test case s22: inter-occasion variability with BLOCK(1) SAME
$INPUT      ID TIME AMT DV MDV EVID WT OCC
$DATA      synthetic_s22.csv IGNORE=@
$SUBROUTINE ADVAN2 TRANS2
$PK
  IOV  = ETA(3)
  IF (OCC.EQ.2) IOV = ETA(4)
  IF (OCC.EQ.3) IOV = ETA(5)
  CL   = THETA(1) * (WT / 70)**THETA(4) * EXP(ETA(1) + IOV)
  V    = THETA(2) * EXP(ETA(2))
  KA   = THETA(3)
  S2   = V
$ERROR
  IPRED = F
  Y     = IPRED * (1 + EPS(1))
$THETA  (0, 4) (0, 30) (0, 1) 0.75
$OMEGA  0.1 0.1
$OMEGA  BLOCK(1) 0.03
$OMEGA  BLOCK(1) SAME
$OMEGA  BLOCK(1) SAME
$SIGMA  0.03
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999 PRINT=5
$COVARIANCE PRINT=E
$TABLE      ID TIME OCC IPRED CWRES NOPRINT ONEHEADER FILE=synthetic_s22.tab
  
