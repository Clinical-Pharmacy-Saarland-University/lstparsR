$PROBLEM    SYNTHETIC lstparsR test case s35: stopped during the search, workflow footer
$INPUT      ID TIME AMT DV MDV
$DATA      synthetic_s35.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  CL = THETA(1) * EXP(ETA(1))
  V  = THETA(2) * EXP(ETA(2))
  S1 = V
$ERROR
  IPRED = F
  Y     = IPRED * (1 + EPS(1))
