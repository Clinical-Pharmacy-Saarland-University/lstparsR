$OMEGA  0.1 0.1
$SIGMA  0.04
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999
$TABLE      ID TIME IPRED NOPRINT ONEHEADER FILE=synthetic_s35.tab
  
