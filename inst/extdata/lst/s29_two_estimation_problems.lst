$PROBLEM    SYNTHETIC lstparsR test case s29: problem 1 of 2, FO with covariance step
$INPUT      ID TIME AMT DV MDV EVID WT
$DATA      synthetic_s29.csv IGNORE=@
$SUBROUTINE ADVAN2 TRANS2
$PK
  TVCL = THETA(1) * (WT / 70)**THETA(4)
  CL   = TVCL * EXP(ETA(1))
  V    = THETA(2) * EXP(ETA(2))
  KA   = THETA(3) * EXP(ETA(3))
  S2   = V
$ERROR
  IPRED = F
  Y     = IPRED * (1 + EPS(1))
$THETA  (0, 4) (0, 30) (0, 1) 0.75
$OMEGA  0.1 0.1 0.3
$SIGMA  0.03
$ESTIMATION METHOD=0 MAXEVAL=9999 PRINT=5
$COVARIANCE PRINT=E
$TABLE      ID TIME IPRED CWRES NOPRINT ONEHEADER FILE=synthetic_s29.tab
  
