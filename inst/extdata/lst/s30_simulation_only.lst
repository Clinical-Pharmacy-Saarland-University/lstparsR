$PROBLEM    SYNTHETIC lstparsR test case s30: simulation only
$INPUT      ID TIME AMT DV MDV
$DATA      synthetic_s30.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  CL = THETA(1) * EXP(ETA(1))
  V  = THETA(2) * EXP(ETA(2))
  S1 = V
$ERROR
  Y = F * (1 + EPS(1))
$THETA  3 25
$OMEGA  0.1 0.1
$SIGMA  0.04
$SIMULATION (20261111) ONLYSIMULATION SUBPROBLEMS=100
$TABLE      ID TIME DV NOPRINT ONEHEADER FILE=synthetic_s30.tab
  
