$PROBLEM    SYNTHETIC lstparsR test case s08: IMPMAP, covariance step successful
$INPUT      ID TIME AMT DV MDV
$DATA      synthetic_s08.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  CL = THETA(1) * EXP(ETA(1))
  V  = THETA(2) * EXP(ETA(2))
  S1 = V
$ERROR
  IPRED = F
  Y     = IPRED * (1 + EPS(1))
$THETA  (0, 3) (0, 25)
$OMEGA  0.1 0.1
$SIGMA  0.04
$ESTIMATION METHOD=IMPMAP INTERACTION ISAMPLE=300 NITER=50
$COVARIANCE PRINT=E
$TABLE      ID TIME IPRED NOPRINT ONEHEADER FILE=synthetic_s08.tab
  
